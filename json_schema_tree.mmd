%%{init: {'theme':'neutral'}}%%
flowchart LR
    Root["Schema Root<br><b>(object)</b>"]

    Root --> S1["intent_schema<br><b>object</b>"]
    Root --> S2["chat_request_schema<br><b>object</b>"]
    Root --> S3["chat_response_schema<br><b>object</b>"]
    Root --> S4["feedback_schema<br><b>object</b>"]

    S1 --- S1_Req["<b>Required:</b><br>intent_name, department, en_answer"]
    S1 --- S1_Props["<b>Properties</b>"]
    S1_Props --> S1_1["intent_name : string<br><i>Unique intent identifier</i>"]
    S1_Props --> S1_2["department : string<br><i>Responsible LGU office</i>"]
    S1_Props --> S1_3["en_answer : string<br><i>English response text</i>"]
    S1_Props --> S1_4["tl_answer : string<br><i>Tagalog response text</i>"]
    S1_Props --> S1_5["bis_answer : string<br><i>Bisaya response text</i>"]
    S1_Props --> S1_6["training_phrases : array[string]<br><i>Sample citizen questions</i>"]

    S2 --- S2_Req["<b>Required:</b><br>message"]
    S2 --- S2_Props["<b>Properties</b>"]
    S2_Props --> S2_1["message : string<br><i>Citizen query (min_length: 1)</i>"]
    S2_Props --> S2_2["language : string<br><i>'auto', 'en', 'tl', or 'bis'</i>"]
    S2_Props --> S2_3["context : string (optional)<br><i>Follow-up menu state</i>"]
    S2_Props --> S2_4["context_language : string (optional)<br><i>Previous context language</i>"]

    S3 --- S3_Req["<b>Required:</b><br>reply, intent, language"]
    S3 --- S3_Props["<b>Properties</b>"]
    S3_Props --> S3_1["reply : string<br><i>Validated response text</i>"]
    S3_Props --> S3_2["summary : string<br><i>LSA-summarized text</i>"]
    S3_Props --> S3_3["intent : string<br><i>Predicted intent tag</i>"]
    S3_Props --> S3_4["language : string<br><i>Resolved language</i>"]
    S3_Props --> S3_5["context : string (optional)<br><i>Follow-up state</i>"]

    S4 --- S4_Req["<b>Required:</b><br>question, intent, helpful"]
    S4 --- S4_Props["<b>Properties</b>"]
    S4_Props --> S4_1["question : string<br><i>Original citizen query</i>"]
    S4_Props --> S4_2["answer : string<br><i>Evaluated response text</i>"]
    S4_Props --> S4_3["intent : string<br><i>Associated service intent</i>"]
    S4_Props --> S4_4["helpful : boolean<br><i>Helpful rating (true/false)</i>"]
    S4_Props --> S4_5["comment : string (optional)<br><i>Citizen feedback text</i>"]

